# ==============================================================================
# NEXUS CONTACT MANAGEMENT CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
#
# IMPORTANT SECURITY GUIDELINES:
# Variables prefixed with VITE_ are embedded into the client bundle and visible
# to anyone inspecting network requests or application source code.
#
# DO NOT ADD SENSITIVE SECRETS HERE.
# Privileged credentials such as:
#   - Twilio Auth Token / Account SID
#   - SendGrid / AWS SES API Keys
#   - WhatsApp Business API System Access Tokens
#   - Meta / Instagram Graph API App Secrets
#   - Database Passwords & Private Keys
# MUST ALWAYS remain on your backend server. The client calls your backend API,
# and the backend safely dispatches messages via third-party providers.
# ==============================================================================

# Backend REST/GraphQL API Base URL (Leave blank to use internal mock repository)
VITE_API_BASE_URL=

# Application Display Branding
VITE_APP_NAME="ComHub"

# Default International Country Calling Code (ISO 3166-1 alpha-2, e.g. US, GB, DE)
VITE_DEFAULT_COUNTRY=US

# Enable mock data storage fallback (set to "false" to require active backend API)
VITE_ENABLE_MOCK_DATA=true
